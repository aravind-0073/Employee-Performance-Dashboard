# Python FastAPI Analytics Service Configuration

# Server
ANALYTICS_PORT=8000
ENVIRONMENT=development

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/student-dashboard
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/student-dashboard

# Analytics Settings
ENABLE_CACHING=true
CACHE_TTL=300

# ML Model Settings
ENABLE_PREDICTIONS=true
PREDICTION_CONFIDENCE_THRESHOLD=0.6

# Logging
LOG_LEVEL=INFO
